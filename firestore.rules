rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId} {
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == driverId);
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid;

      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (isDriver() && resource.data.driverId == request.auth.uid);

      allow update: if isAdmin()
        || (isDriver()
            && resource.data.driverId == request.auth.uid
            && request.resource.data.driverId == request.auth.uid);

      allow delete: if isAdmin();
    }
  }
}
